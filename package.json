{
  "name": "fund-admin-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "gen:cases": "node scripts/build-case-index.mjs",
    "gen:glossary": "node scripts/build-glossary-import.mjs",
    "scan:terms": "node --no-warnings scripts/scan-term-candidates.mjs",
    "check:glossary": "node scripts/check-glossary.mjs",
    "check:lesson-numbers": "node scripts/check-lesson-numbers.mjs",
    "prebuild": "npm run check:lesson-numbers && npm run check:glossary && npm run gen:cases && npm run gen:glossary && npm run scan:terms",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
